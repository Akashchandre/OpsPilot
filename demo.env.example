# Copy to demo.env on the EC2 host. Never commit demo.env or send its values in chat.
# Use only the generated CloudFront HTTPS origin, without a trailing slash.
OPSPILOT_DEMO_PUBLIC_ORIGIN=https://CHANGE_ME.cloudfront.net
OPSPILOT_DEMO_HTTP_PORT=80

# Use independent random hexadecimal values so the password is URL-safe.
OPSPILOT_COMPOSE_MYSQL_ROOT_PASSWORD=CHANGE_ME
OPSPILOT_COMPOSE_MYSQL_PASSWORD=CHANGE_ME
OPSPILOT_COMPOSE_DATABASE_URL=mysql://opspilot:CHANGE_ME@mysql:3306/opspilot_compose
OPSPILOT_COMPOSE_SHADOW_DATABASE_URL=mysql://opspilot:CHANGE_ME@mysql:3306/opspilot_shadow
OPSPILOT_COMPOSE_DATABASE_PROBE_INTERVAL_MS=5000
OPSPILOT_COMPOSE_DATABASE_FAILURE_EXIT_MS=30000

# Canonical Base64 containing at least 32 random bytes.
OPSPILOT_COMPOSE_AUDIT_INTEGRITY_KEY=CHANGE_ME
OPSPILOT_COMPOSE_AUDIT_INTEGRITY_KEY_ID=demo-v1
OPSPILOT_COMPOSE_API_HOST_PORT=4000

# Razorpay Test Mode only. The key ID must start with rzp_test_.
OPSPILOT_DEMO_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
OPSPILOT_DEMO_RAZORPAY_KEY_SECRET=CHANGE_ME
OPSPILOT_DEMO_RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ADR 0017 enables every AI capability only for fictional demo data. Each key must be independently
# generated canonical Base64 containing exactly 32 random bytes. Never reuse the audit key.
OPSPILOT_DEMO_AI_LOCAL_TOPOLOGY_ACCEPTED=true
OPSPILOT_DEMO_AI_ENABLED=true
OPSPILOT_DEMO_AI_SERVICE_SIGNING_KEY=CHANGE_ME
OPSPILOT_DEMO_AI_SERVICE_SIGNING_KEY_ID=demo-node-to-ai-v1
OPSPILOT_DEMO_GROQ_API_KEY=CHANGE_ME
OPSPILOT_DEMO_GROQ_ZERO_DATA_RETENTION_CONFIRMED=true
OPSPILOT_DEMO_DOCUMENTS_ENABLED=true
OPSPILOT_DEMO_DOCUMENT_ENCRYPTION_KEY=CHANGE_ME
OPSPILOT_DEMO_DOCUMENT_ENCRYPTION_KEY_ID=demo-documents-v1
OPSPILOT_DEMO_AI_WORKFLOWS_ENABLED=true
OPSPILOT_DEMO_AI_BUSINESS_BRIEF_ENABLED=true
OPSPILOT_DEMO_AI_SUPPORT_WORKFLOW_ENABLED=true
OPSPILOT_DEMO_AI_SUPPORT_DATA_PROCESSING_CONFIRMED=true
OPSPILOT_DEMO_AI_WORKFLOW_NODE_SIGNING_KEY=CHANGE_ME
OPSPILOT_DEMO_AI_WORKFLOW_NODE_SIGNING_KEY_ID=demo-ai-to-node-v1
OPSPILOT_DEMO_AI_WORKFLOW_ARTIFACT_KEY=CHANGE_ME
OPSPILOT_DEMO_AI_WORKFLOW_ARTIFACT_KEY_ID=demo-workflow-artifacts-v1
