# Copy this file to the ignored compose.env and replace every blank/placeholder value.
# Never commit compose.env or reuse these local credentials in AWS.
OPSPILOT_COMPOSE_MYSQL_ROOT_PASSWORD=
OPSPILOT_COMPOSE_MYSQL_PASSWORD=
# URL-encode the password component and keep the host/database exactly as shown.
OPSPILOT_COMPOSE_DATABASE_URL=mysql://opspilot:URL_ENCODED_PASSWORD@mysql:3306/opspilot_compose
OPSPILOT_COMPOSE_DATABASE_PROBE_INTERVAL_MS=5000
OPSPILOT_COMPOSE_DATABASE_FAILURE_EXIT_MS=30000
# Prisma configuration requires a distinct URL even though `migrate deploy` never uses a shadow
# database. Keep this database name distinct and never run `migrate dev` in Compose.
OPSPILOT_COMPOSE_SHADOW_DATABASE_URL=mysql://opspilot:URL_ENCODED_PASSWORD@mysql:3306/opspilot_shadow
# Canonical Base64 containing at least 32 random bytes.
OPSPILOT_COMPOSE_AUDIT_INTEGRITY_KEY=
OPSPILOT_COMPOSE_AUDIT_INTEGRITY_KEY_ID=compose-local-v1
OPSPILOT_COMPOSE_CORS_ORIGIN=http://127.0.0.1:5173
OPSPILOT_COMPOSE_API_HOST_PORT=4000

# Required only for the optional AI profile. Provider/RAG/workflows remain forced off.
OPSPILOT_COMPOSE_AI_ENABLED=false
OPSPILOT_COMPOSE_AI_SIGNING_KEY=
OPSPILOT_COMPOSE_AI_SIGNING_KEY_ID=compose-ai-local-v1
