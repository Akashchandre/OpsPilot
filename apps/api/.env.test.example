AUTH_CSRF_COOKIE_NAME=opspilot_test_csrf
AUTH_SESSION_TTL_HOURS=1
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=100
