NODE_ENV=test
API_HOST=127.0.0.1
API_PORT=4001
CORS_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=mysql://opspilot_local:replace-with-url-encoded-password@127.0.0.1:3306/opspilot_test
SHADOW_DATABASE_URL=mysql://opspilot_local:replace-with-url-encoded-password@127.0.0.1:3306/opspilot_shadow
