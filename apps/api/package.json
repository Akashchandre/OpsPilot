{
  "name": "@opspilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.js",
    "dev:worker": "tsx watch src/worker.js",
    "start": "tsx src/server.js",
    "start:worker": "tsx src/worker.js",
    "auth:bootstrap-owner": "tsx src/scripts/bootstrapOwner.js",
    "payments:razorpay:check": "tsx src/scripts/checkRazorpay.js",
    "phase5:performance:data": "tsx src/scripts/phase5PerformanceData.js",
    "phase5:performance:profile": "tsx src/scripts/phase5PerformanceProfile.js",
    "phase5:audit:verify": "tsx src/scripts/verifyAuditChain.js",
    "phase6:performance:profile": "tsx src/scripts/phase6PerformanceProfile.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "socket.io": "4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
