generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SecurityEventType {
  USER_REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT_SUCCEEDED
  OWNER_BOOTSTRAPPED
  USER_STATUS_CHANGED
  ROLE_ASSIGNED
  ROLE_REMOVED
}

enum SecurityEventOutcome {
  SUCCESS
  FAILURE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum InventoryAdjustmentReason {
  INITIAL
  RESTOCK
  CORRECTION
  DAMAGE
  ORDER_RESERVATION
  ORDER_RELEASE
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  PAYMENT_REVIEW
}

enum OrderEventSource {
  CUSTOMER
  OPERATOR
  PROVIDER
  SYSTEM
  RECONCILIATION
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentStatus {
  CREATING
  OPEN
  CAPTURED
  REFUND_PENDING
  REFUNDED
  REVIEW_REQUIRED
}

enum PaymentAttemptStatus {
  AUTHORIZED
  CAPTURED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ProviderWebhookStatus {
  PROCESSED
  IGNORED
  REVIEW_REQUIRED
}

enum SupportTicketCategory {
  GENERAL
  ORDER
  PAYMENT
  PRODUCT
  ACCOUNT
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportMessageVisibility {
  CUSTOMER_VISIBLE
  INTERNAL
}

enum SupportTicketEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
}

enum SupportTicketEventSource {
  CUSTOMER
  OPERATOR
  SYSTEM
}

enum AuditActorKind {
  USER
  SYSTEM
  PROVIDER
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id                   String                 @id @default(uuid()) @db.Char(36)
  email                String                 @unique @db.VarChar(254)
  passwordHash         String                 @map("password_hash") @db.VarChar(255)
  displayName          String                 @map("display_name") @db.VarChar(100)
  status               UserStatus             @default(ACTIVE)
  failedLoginAttempts  Int                    @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?              @map("locked_until") @db.DateTime(3)
  passwordChangedAt    DateTime               @default(now()) @map("password_changed_at") @db.DateTime(3)
  createdAt            DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  roles                UserRole[]             @relation("UserRoleUser")
  roleAssignments      UserRole[]             @relation("UserRoleAssigner")
  sessions             AuthSession[]
  actorSecurityEvents  SecurityEvent[]        @relation("SecurityEventActor")
  targetSecurityEvents SecurityEvent[]        @relation("SecurityEventTarget")
  inventoryAdjustments InventoryAdjustment[]  @relation("InventoryAdjustmentActor")
  cart                 Cart?
  orders               Order[]                @relation("OrderCustomer")
  orderStatusEvents    OrderStatusEvent[]     @relation("OrderStatusEventActor")
  initiatedRefunds     Refund[]               @relation("RefundActor")
  requestedTickets     SupportTicket[]        @relation("SupportTicketRequester")
  assignedTickets      SupportTicket[]        @relation("SupportTicketAssignee")
  supportMessages      SupportTicketMessage[] @relation("SupportTicketMessageAuthor")
  supportTicketEvents  SupportTicketEvent[]   @relation("SupportTicketEventActor")
  auditEvents          AuditEvent[]           @relation("AuditEventActor")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Char(36)
  code            String           @unique @db.VarChar(50)
  name            String           @db.VarChar(100)
  description     String           @db.VarChar(255)
  isSystem        Boolean          @default(true) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Char(36)
  code            String           @unique @db.VarChar(100)
  description     String           @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Char(36)
  roleId       String   @map("role_id") @db.Char(36)
  assignedById String?  @map("assigned_by_id") @db.Char(36)
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  user         User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?    @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Char(36)
  permissionId String     @map("permission_id") @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Char(36)
  userId        String    @map("user_id") @db.Char(36)
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.DateTime(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  revokedAt     DateTime? @map("revoked_at") @db.DateTime(3)
  userAgentHash String?   @map("user_agent_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model SecurityEvent {
  id           String               @id @default(uuid()) @db.Char(36)
  eventType    SecurityEventType    @map("event_type")
  outcome      SecurityEventOutcome
  actorUserId  String?              @map("actor_user_id") @db.Char(36)
  targetUserId String?              @map("target_user_id") @db.Char(36)
  requestId    String?              @map("request_id") @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  actor        User?                @relation("SecurityEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?                @relation("SecurityEventTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([eventType, createdAt])
  @@index([requestId])
  @@map("security_events")
}

model Category {
  id          String            @id @default(uuid()) @db.Char(36)
  slug        String            @unique @db.VarChar(100)
  name        String            @db.VarChar(100)
  description String?           @db.VarChar(500)
  status      CategoryStatus    @default(ACTIVE)
  version     Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  products    ProductCategory[]

  @@index([status, name])
  @@map("categories")
}

model Product {
  id                    String                 @id @default(uuid()) @db.Char(36)
  sku                   String                 @unique @db.VarChar(64)
  name                  String                 @db.VarChar(160)
  description           String                 @db.Text
  price                 Decimal                @db.Decimal(12, 2)
  currency              String                 @db.Char(3)
  status                ProductStatus          @default(DRAFT)
  version               Int                    @default(0)
  createdAt             DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  categories            ProductCategory[]
  inventoryBalance      InventoryBalance?
  inventoryAdjustments  InventoryAdjustment[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]

  @@index([status, createdAt])
  @@index([status, name])
  @@index([status, price])
  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Char(36)
  categoryId String   @map("category_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
  @@map("product_categories")
}

model InventoryBalance {
  productId         String   @id @map("product_id") @db.Char(36)
  onHand            Int      @default(0) @map("on_hand")
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([onHand])
  @@map("inventory_balances")
}

model InventoryAdjustment {
  id             String                    @id @default(uuid()) @db.Char(36)
  productId      String                    @map("product_id") @db.Char(36)
  delta          Int
  quantityBefore Int                       @map("quantity_before")
  quantityAfter  Int                       @map("quantity_after")
  reason         InventoryAdjustmentReason
  note           String?                   @db.VarChar(500)
  actorUserId    String?                   @map("actor_user_id") @db.Char(36)
  requestId      String?                   @map("request_id") @db.VarChar(64)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  product        Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor          User?                     @relation("InventoryAdjustmentActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([requestId])
  @@map("inventory_adjustments")
}

model Cart {
  id        String     @id @default(uuid()) @db.Char(36)
  userId    String     @unique @map("user_id") @db.Char(36)
  version   Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  cartId            String   @map("cart_id") @db.Char(36)
  productId         String   @map("product_id") @db.Char(36)
  quantity          Int
  observedUnitPrice Decimal  @map("observed_unit_price") @db.Decimal(12, 2)
  observedCurrency  String   @map("observed_currency") @db.Char(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  cart              Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id                   String                 @id @default(uuid()) @db.Char(36)
  orderNumber          String                 @unique @map("order_number") @db.VarChar(24)
  userId               String                 @map("user_id") @db.Char(36)
  status               OrderStatus            @default(PENDING_PAYMENT)
  subtotal             Decimal                @db.Decimal(14, 2)
  taxTotal             Decimal                @default(0) @map("tax_total") @db.Decimal(14, 2)
  discountTotal        Decimal                @default(0) @map("discount_total") @db.Decimal(14, 2)
  shippingTotal        Decimal                @default(0) @map("shipping_total") @db.Decimal(14, 2)
  total                Decimal                @db.Decimal(14, 2)
  currency             String                 @db.Char(3)
  recipientName        String                 @map("recipient_name") @db.VarChar(100)
  phone                String                 @db.VarChar(16)
  addressLine1         String                 @map("address_line_1") @db.VarChar(200)
  addressLine2         String?                @map("address_line_2") @db.VarChar(200)
  city                 String                 @db.VarChar(100)
  state                String                 @db.VarChar(100)
  postalCode           String                 @map("postal_code") @db.Char(6)
  countryCode          String                 @default("IN") @map("country_code") @db.Char(2)
  carrierName          String?                @map("carrier_name") @db.VarChar(100)
  trackingNumber       String?                @map("tracking_number") @db.VarChar(100)
  reservationExpiresAt DateTime               @map("reservation_expires_at") @db.DateTime(3)
  confirmedAt          DateTime?              @map("confirmed_at") @db.DateTime(3)
  processingAt         DateTime?              @map("processing_at") @db.DateTime(3)
  shippedAt            DateTime?              @map("shipped_at") @db.DateTime(3)
  deliveredAt          DateTime?              @map("delivered_at") @db.DateTime(3)
  cancelledAt          DateTime?              @map("cancelled_at") @db.DateTime(3)
  expiredAt            DateTime?              @map("expired_at") @db.DateTime(3)
  idempotencyKey       String                 @map("idempotency_key") @db.Char(36)
  requestHash          String                 @map("request_hash") @db.Char(64)
  version              Int                    @default(0)
  createdAt            DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  user                 User                   @relation("OrderCustomer", fields: [userId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  reservations         InventoryReservation[]
  statusEvents         OrderStatusEvent[]
  payment              Payment?
  supportTickets       SupportTicket[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
  @@map("orders")
}

model OrderItem {
  id          String                @id @default(uuid()) @db.Char(36)
  orderId     String                @map("order_id") @db.Char(36)
  productId   String                @map("product_id") @db.Char(36)
  productSku  String                @map("product_sku") @db.VarChar(64)
  productName String                @map("product_name") @db.VarChar(160)
  unitPrice   Decimal               @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal               @map("line_total") @db.Decimal(14, 2)
  currency    String                @db.Char(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservation InventoryReservation?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model InventoryReservation {
  id          String                     @id @default(uuid()) @db.Char(36)
  orderId     String                     @map("order_id") @db.Char(36)
  orderItemId String                     @unique @map("order_item_id") @db.Char(36)
  productId   String                     @map("product_id") @db.Char(36)
  quantity    Int
  status      InventoryReservationStatus @default(ACTIVE)
  expiresAt   DateTime                   @map("expires_at") @db.DateTime(3)
  consumedAt  DateTime?                  @map("consumed_at") @db.DateTime(3)
  releasedAt  DateTime?                  @map("released_at") @db.DateTime(3)
  version     Int                        @default(0)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)
  order       Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem                  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product     Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([status, expiresAt])
  @@index([productId, status])
  @@map("inventory_reservations")
}

model OrderStatusEvent {
  id          String           @id @default(uuid()) @db.Char(36)
  orderId     String           @map("order_id") @db.Char(36)
  fromStatus  OrderStatus?     @map("from_status")
  toStatus    OrderStatus      @map("to_status")
  source      OrderEventSource
  reasonCode  String           @map("reason_code") @db.VarChar(64)
  actorUserId String?          @map("actor_user_id") @db.Char(36)
  requestId   String?          @map("request_id") @db.VarChar(64)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor       User?            @relation("OrderStatusEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([requestId])
  @@map("order_status_events")
}

model Payment {
  id                  String                 @id @default(uuid()) @db.Char(36)
  orderId             String                 @unique @map("order_id") @db.Char(36)
  provider            PaymentProvider        @default(RAZORPAY)
  status              PaymentStatus          @default(CREATING)
  amount              Decimal                @db.Decimal(14, 2)
  currency            String                 @db.Char(3)
  providerOrderId     String?                @unique @map("provider_order_id") @db.VarChar(64)
  providerReceipt     String                 @unique @map("provider_receipt") @db.VarChar(40)
  providerOrderStatus String?                @map("provider_order_status") @db.VarChar(32)
  lastProviderEventAt DateTime?              @map("last_provider_event_at") @db.DateTime(3)
  version             Int                    @default(0)
  createdAt           DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  order               Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts            PaymentAttempt[]
  refunds             Refund[]
  webhookEvents       ProviderWebhookEvent[]

  @@index([status, createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Char(36)
  paymentId         String               @map("payment_id") @db.Char(36)
  providerPaymentId String               @unique @map("provider_payment_id") @db.VarChar(64)
  status            PaymentAttemptStatus
  amount            Decimal              @db.Decimal(14, 2)
  currency          String               @db.Char(3)
  failureCode       String?              @map("failure_code") @db.VarChar(100)
  providerCreatedAt DateTime?            @map("provider_created_at") @db.DateTime(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refunds           Refund[]

  @@index([paymentId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, currency, createdAt, amount])
  @@map("payment_attempts")
}

model Refund {
  id                String         @id @default(uuid()) @db.Char(36)
  paymentId         String         @map("payment_id") @db.Char(36)
  paymentAttemptId  String         @map("payment_attempt_id") @db.Char(36)
  status            RefundStatus   @default(PENDING)
  amount            Decimal        @db.Decimal(14, 2)
  currency          String         @db.Char(3)
  idempotencyKey    String         @map("idempotency_key") @db.Char(36)
  requestHash       String         @map("request_hash") @db.Char(64)
  providerRefundId  String?        @unique @map("provider_refund_id") @db.VarChar(64)
  failureCode       String?        @map("failure_code") @db.VarChar(100)
  actorUserId       String?        @map("actor_user_id") @db.Char(36)
  providerCreatedAt DateTime?      @map("provider_created_at") @db.DateTime(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  payment           Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentAttempt    PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  actor             User?          @relation("RefundActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([paymentId, idempotencyKey])
  @@index([paymentAttemptId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, currency, updatedAt, amount])
  @@map("refunds")
}

model ProviderWebhookEvent {
  id                String                @id @default(uuid()) @db.Char(36)
  provider          PaymentProvider
  providerEventId   String                @map("provider_event_id") @db.VarChar(100)
  eventType         String                @map("event_type") @db.VarChar(64)
  bodyDigest        String                @map("body_digest") @db.Char(64)
  status            ProviderWebhookStatus
  paymentId         String?               @map("payment_id") @db.Char(36)
  safeCode          String?               @map("safe_code") @db.VarChar(64)
  providerCreatedAt DateTime?             @map("provider_created_at") @db.DateTime(3)
  receivedAt        DateTime              @default(now()) @map("received_at") @db.DateTime(3)
  processedAt       DateTime              @map("processed_at") @db.DateTime(3)
  payment           Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@index([eventType, receivedAt])
  @@map("provider_webhook_events")
}

model SupportTicket {
  id             String                 @id @default(uuid()) @db.Char(36)
  ticketNumber   String                 @unique @map("ticket_number") @db.VarChar(24)
  requesterId    String                 @map("requester_id") @db.Char(36)
  orderId        String?                @map("order_id") @db.Char(36)
  assigneeId     String?                @map("assignee_id") @db.Char(36)
  category       SupportTicketCategory
  subject        String                 @db.VarChar(160)
  priority       SupportTicketPriority  @default(NORMAL)
  status         SupportTicketStatus    @default(OPEN)
  version        Int                    @default(0)
  idempotencyKey String                 @map("idempotency_key") @db.Char(36)
  requestHash    String                 @map("request_hash") @db.Char(64)
  resolvedAt     DateTime?              @map("resolved_at") @db.DateTime(3)
  closedAt       DateTime?              @map("closed_at") @db.DateTime(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  requester      User                   @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  order          Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignee       User?                  @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages       SupportTicketMessage[]
  events         SupportTicketEvent[]

  @@unique([requesterId, idempotencyKey])
  @@index([requesterId, updatedAt])
  @@index([status, priority, updatedAt])
  @@index([assigneeId, status, updatedAt])
  @@index([orderId])
  @@index([createdAt, status, priority])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id             String                   @id @default(uuid()) @db.Char(36)
  ticketId       String                   @map("ticket_id") @db.Char(36)
  authorUserId   String                   @map("author_user_id") @db.Char(36)
  visibility     SupportMessageVisibility @default(CUSTOMER_VISIBLE)
  body           String                   @db.Text
  idempotencyKey String                   @map("idempotency_key") @db.Char(36)
  requestHash    String                   @map("request_hash") @db.Char(64)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  ticket         SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author         User                     @relation("SupportTicketMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([ticketId, authorUserId, idempotencyKey], map: "support_messages_author_idempotency_key")
  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("support_ticket_messages")
}

model SupportTicketEvent {
  id                 String                   @id @default(uuid()) @db.Char(36)
  ticketId           String                   @map("ticket_id") @db.Char(36)
  eventType          SupportTicketEventType   @map("event_type")
  source             SupportTicketEventSource
  fromStatus         SupportTicketStatus?     @map("from_status")
  toStatus           SupportTicketStatus?     @map("to_status")
  fromPriority       SupportTicketPriority?   @map("from_priority")
  toPriority         SupportTicketPriority?   @map("to_priority")
  previousAssigneeId String?                  @map("previous_assignee_id") @db.Char(36)
  nextAssigneeId     String?                  @map("next_assignee_id") @db.Char(36)
  reasonCode         String                   @map("reason_code") @db.VarChar(64)
  actorUserId        String?                  @map("actor_user_id") @db.Char(36)
  requestId          String?                  @map("request_id") @db.VarChar(64)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  ticket             SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor              User?                    @relation("SupportTicketEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([requestId])
  @@map("support_ticket_events")
}

model AuditChainHead {
  id           Int      @id
  headSequence BigInt   @default(0) @map("head_sequence")
  headHash     String   @map("head_hash") @db.Char(64)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("audit_chain_heads")
}

model AuditEvent {
  id           String         @id @default(uuid()) @db.Char(36)
  sequence     BigInt         @unique
  action       String         @db.VarChar(100)
  outcome      AuditOutcome
  actorKind    AuditActorKind @map("actor_kind")
  actorUserId  String?        @map("actor_user_id") @db.Char(36)
  targetType   String         @map("target_type") @db.VarChar(64)
  targetId     String?        @map("target_id") @db.VarChar(100)
  requestId    String?        @map("request_id") @db.VarChar(64)
  metadata     Json?
  occurredAt   DateTime       @default(now()) @map("occurred_at") @db.DateTime(3)
  previousHash String         @map("previous_hash") @db.Char(64)
  keyId        String         @map("key_id") @db.VarChar(64)
  eventHash    String         @unique @map("event_hash") @db.Char(64)
  actor        User?          @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([action, occurredAt])
  @@index([requestId])
  @@map("audit_events")
}
