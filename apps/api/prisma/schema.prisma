model BackgroundJob {
  id                   String                 @id @default(uuid()) @db.Char(36)
  type                 BackgroundJobType
  schemaVersion        Int                    @default(1) @map("schema_version")
  status               BackgroundJobStatus    @default(PENDING)
  dedupeKey            String                 @unique @map("dedupe_key") @db.VarChar(191)
  payload              Json
  availableAt          DateTime               @default(now()) @map("available_at") @db.DateTime(3)
  attemptCount         Int                    @default(0) @map("attempt_count")
  maxAttempts          Int                    @default(8) @map("max_attempts")
  leaseToken           String?                @map("lease_token") @db.Char(64)
  leaseOwnerId         String?                @map("lease_owner_id") @db.Char(36)
  leaseExpiresAt       DateTime?              @map("lease_expires_at") @db.DateTime(3)
  lastErrorCode        String?                @map("last_error_code") @db.VarChar(64)
  sourceRequestId      String?                @map("source_request_id") @db.VarChar(64)
  sourceActorUserId    String?                @map("source_actor_user_id") @db.Char(36)
  replayedFromJobId    String?                @map("replayed_from_job_id") @db.Char(36)
  replayIdempotencyKey String?                @map("replay_idempotency_key") @db.Char(36)
  completedAt          DateTime?              @map("completed_at") @db.DateTime(3)
  deadLetteredAt       DateTime?              @map("dead_lettered_at") @db.DateTime(3)
  version              Int                    @default(0)
  createdAt            DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  leaseOwner           WorkerHeartbeat?       @relation(fields: [leaseOwnerId], references: [id], onDelete: SetNull)
  sourceActor          User?                  @relation("BackgroundJobSourceActor", fields: [sourceActorUserId], references: [id], onDelete: SetNull)
  replayedFrom         BackgroundJob?         @relation("BackgroundJobReplay", fields: [replayedFromJobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replays              BackgroundJob[]        @relation("BackgroundJobReplay")
  attempts             BackgroundJobAttempt[]

  @@unique([replayedFromJobId, replayIdempotencyKey], map: "background_jobs_replay_idempotency_key")
  @@index([status, availableAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([type, status, createdAt])
  @@index([leaseOwnerId, status])
  @@index([sourceActorUserId, createdAt])
  @@index([replayedFromJobId])
  @@map("background_jobs")
}

